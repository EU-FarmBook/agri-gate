# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8900
APP_VERSION=dev

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------------------------
# Malware scanning
# ------------------------------------------------------------------------------
CLAMD_ADDR=
FILE_SCAN_ENABLED=true
FILE_SCAN_STRICT=false

# ------------------------------------------------------------------------------
# File policy
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_FILE_TYPES=application/pdf,text/plain,text/csv,text/tab-separated-values,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,audio/mpeg,audio/wav,audio/x-wav,audio/mp4,audio/x-m4a,video/mp4,video/x-msvideo,video/quicktime,video/x-ms-wmv,video/mpeg,video/x-matroska,video/x-flv,video/webm,video/3gpp,video/mp2t,video/dvd

# ------------------------------------------------------------------------------
# Deep inspection limits
# ------------------------------------------------------------------------------
MAX_ARCHIVE_DEPTH=3
MAX_ARCHIVE_ENTRIES=2048
MAX_EXPANDED_BYTES=209715200

# ------------------------------------------------------------------------------
# URL scanning
# ------------------------------------------------------------------------------
MAX_REDIRECTS=5
HTTP_TIMEOUT_SECONDS=10
